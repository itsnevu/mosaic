# Production chain (Robinhood Chain). Leave unset to run against local Anvil.
# NEXT_PUBLIC_* values are inlined at build time — set them before `next build`.
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_CHAIN_NAME=Robinhood Chain
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_EXPLORER_URL=
NEXT_PUBLIC_NATIVE_SYMBOL=ETH

# Deployed addresses on that chain. NEXT_PUBLIC_POOLS is a JSON array of
# [{"name":"Turret","pool":"0x…","adapter":"0x…","targetWeightBps":4000,"apyBps":900}]
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_USDG_ADDRESS=
NEXT_PUBLIC_POOLS=[]

# --- keeper (scripts/keeper.mjs), server-side only ---
RPC_URL=http://127.0.0.1:8545
KEEPER_PRIVATE_KEY=
DEPLOYMENT=contracts/deployments/local.json
INTERVAL_MS=60000
# native token price in USD, so gas can be priced into the vault's profitability gate
NATIVE_USD=
COST_MARGIN=1.5
SCORING=0

# --- production deploy (contracts/script/DeployProduction.s.sol) ---
USDG_ADDRESS=
VAULT_OWNER=
FEE_RECIPIENT=
# comma-separated adapter addresses and their target weights in bps (must sum to 10000)
ADAPTERS=
WEIGHTS_BPS=
