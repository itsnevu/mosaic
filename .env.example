# Production chain (Robinhood Chain). Leave unset to run against local Anvil.
# NEXT_PUBLIC_* values are inlined at build time — set them before `next build`.
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_CHAIN_NAME=Robinhood Chain
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_EXPLORER_URL=
NEXT_PUBLIC_NATIVE_SYMBOL=ETH

# Deployed addresses on that chain. NEXT_PUBLIC_POOLS is a JSON array of
# [{"name":"Turret","pool":"0x…","adapter":"0x…","targetWeightBps":4000,"apyBps":900}]
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_USDG_ADDRESS=
NEXT_PUBLIC_POOLS=[]
# Block the vault was deployed at. History, the share price chart, a wallet's earnings and the
# depositor count all scan back to this. Without it those read "—" rather than a number that
# quietly means "since some block".
NEXT_PUBLIC_DEPLOY_BLOCK=
# Recent-window reads (used only when no deploy block is set) walk back in chunks of this size.
NEXT_PUBLIC_LOG_CHUNK=10000
NEXT_PUBLIC_LOG_MAX_CHUNKS=12
# Whole-history reads ask for the full range first and narrow only if the provider refuses.
# This bounds the requests one scan may spend before it reports itself incomplete.
NEXT_PUBLIC_LOG_REQUEST_BUDGET=160

# --- read relay (src/app/api/rpc/route.ts), server-side only ---
# Upstream for browser reads; defaults to NEXT_PUBLIC_RPC_URL. Live answers are shared for
# RPC_RELAY_TTL_MS; logs and blocks at least 128 blocks behind the head for RPC_RELAY_HISTORY_TTL_MS.
RPC_UPSTREAM_URL=
RPC_RELAY_TTL_MS=2000
RPC_RELAY_HISTORY_TTL_MS=3600000

# --- keeper (scripts/keeper.mjs), server-side only ---
# RPC_URL takes a comma-separated list; the keeper fails over in order.
RPC_URL=http://127.0.0.1:8545
KEEPER_PRIVATE_KEY=
DEPLOYMENT=contracts/deployments/local.json
INTERVAL_MS=60000
TICK_TIMEOUT_MS=120000
# native token price in USD, so gas can be priced into the vault's profitability gate
NATIVE_USD=
COST_MARGIN=1.5
SCORING=0

# staying up: alerting, health and multi-instance
ALERT_WEBHOOK_URL=
ALERT_AFTER_FAILURES=3
MIN_GAS_BALANCE=0.05
HEALTH_PORT=
HEARTBEAT_FILE=
INSTANCE=
JITTER_MS=0

# --- production deploy (contracts/script/DeployProduction.s.sol) ---
USDG_ADDRESS=
VAULT_OWNER=
FEE_RECIPIENT=
# comma-separated adapter addresses and their target weights in bps (must sum to 10000)
ADAPTERS=
WEIGHTS_BPS=
